<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Drop Row <%= row.id %></title>
    <link rel="stylesheet" href="/public/style.css" />
  </head>
  <body>
    <main class="shell small">
      <p><a href="/dashboard">Back</a></p>
      <h1>Drop row <%= row.id %></h1>
      <p class="muted">mobid <strong><%= row.mobid %></strong> | itemid <strong><%= row.itemid %></strong></p>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>
      <% if (message) { %>
        <p class="ok"><%= message %></p>
      <% } %>

      <% if (!allowEdits) { %>
        <p class="warn">Read-only mode. Set ALLOW_EDITS=true to enable updates.</p>
      <% } %>

      <form method="post" action="/drop/<%= row.id %>/preview" class="stack">
        <label>chance <input name="chance" type="number" min="0" value="<%= row.chance %>" <%= allowEdits ? "" : "disabled" %> /></label>
        <label>minquant <input name="minquant" type="number" min="0" value="<%= row.minquant %>" <%= allowEdits ? "" : "disabled" %> /></label>
        <label>maxquant <input name="maxquant" type="number" min="0" value="<%= row.maxquant %>" <%= allowEdits ? "" : "disabled" %> /></label>
        <button type="submit" <%= allowEdits ? "" : "disabled" %>>Preview change</button>
      </form>
    </main>
  </body>
</html>
